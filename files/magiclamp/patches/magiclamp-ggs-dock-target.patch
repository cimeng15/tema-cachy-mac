 // Returns which screen edge a dock panel is closest to.
@@ -69,9 +77,191 @@ static Direction dockEdge(KWin::EffectWindow* dock)
 // Position is translated by the screen-origin offset so that an icon at local
 // position (x, y) within the source panel maps to the same local position in
 // the target panel — exact for identical panel layouts, reasonable otherwise.
+// GGS: target minimize diarahkan ke ikon DOCK, bukan ke panel Plasma.
+//   1) minimize_target.json  -> posisi ikon yang barusan diklik (paling akurat)
+//   2) dock_rects.json       -> peta semua ikon (untuk minimize via tombol
+//                               jendela / shortcut keyboard)
+//   3) kalau dua-duanya tidak ada -> perilaku normal (iconGeometry)
+static QString ggsNorm(const QString &s)
+{
+    QString out;
+    out.reserve(s.size());
+    for (const QChar c : s) {
+        if (c.isLetterOrNumber()) {
+            out.append(c.toLower());
+        }
+    }
+    return out;
+}
+
+// Apakah rect ini berada di dalam salah satu layar (koordinat absolut layar)?
+// Memakai area layar penuh (termasuk area yang dipakai dock/panel), karena
+// ikon dock memang berada di area strut.
+static bool ggsOnSomeScreen(const QRectF &r)
+{
+    KWin::LogicalOutput *s = KWin::effects->screenAt(r.center().toPoint());
+    if (!s) {
+        return false;
+    }
+    const QRectF full = KWinCompat::fullScreenArea(KWin::effects, s);
+    return full.isEmpty() || full.adjusted(-2.0, -2.0, 2.0, 2.0).contains(r);
+}
+
+// Dock memublikasikan posisi ikon dalam koordinat ABSOLUT layar
+// (lihat DockMain.qml::publishIconRects). Data versi lama memakai koordinat
+// relatif terhadap surface dock. Terima yang masuk akal saja.
+//
+// BUG LAMA: koordinat absolut ditambah origin dock lagi, jadi target animasi
+// jatuh di luar layar (mis. y = 1076 + 1011 = 2087 pada layar 1080p) dan
+// "genie" menyembur ke bawah layar.
+static QRectF ggsPlausibleRect(const QRectF &r, KWin::EffectWindow *dock)
+{
+    if (!(r.width() > 1.0) || !(r.height() > 1.0)) {
+        return QRectF();
+    }
+    if (ggsOnSomeScreen(r)) {
+        return r; // koordinat absolut (dipakai dock versi sekarang)
+    }
+    if (dock) {
+        const QRectF shifted = r.translated(dock->frameGeometry().topLeft());
+        if (ggsOnSomeScreen(shifted)) {
+            return shifted; // koordinat relatif terhadap dock (data versi lama)
+        }
+    }
+    return QRectF();
+}
+
+static KWin::EffectWindow *ggsDockWindow(KWin::EffectWindow *w)
+{
+    // Ketiga surface GGS (topbar, notch, dock) berasal dari binary yang sama
+    // sehingga windowClass-nya identik: "goldengateshell-topbar". Karena itu
+    // pemilihan HANYA bisa memakai geometri.
+    //
+    // Dock selalu di-anchor ke BAWAH layar. Topbar & notch menempel di ATAS
+    // (y=0). Jadi syarat yang benar: window GGS yang menempel di tepi bawah
+    // layar. Tingginya TIDAK boleh dipakai sebagai pembeda, karena dock yang
+    // sedang auto-hide hanya setinggi 4px — dulu filter "height < 60" membuat
+    // dock tidak pernah terdeteksi dan animasi minimize nyangkut.
+    //
+    // Layar dock dipilih berdasarkan layar jendela yang di-minimize (bukan
+    // posisi kursor), supaya di multi-monitor animasi tetap menuju dock yang
+    // benar.
+    KWin::LogicalOutput *s = w ? KWin::effects->screenAt(w->frameGeometry().center().toPoint())
+                               : nullptr;
+    if (!s) {
+        s = KWin::effects->screenAt(KWin::effects->cursorPos().toPoint());
+    }
+    if (!s) {
+        s = KWin::effects->activeScreen();
+    }
+    QRectF screenRect;
+    if (s) {
+        screenRect = KWin::effects->clientArea(KWin::ScreenArea, s);
+    }
+
+    KWin::EffectWindow *best = nullptr;
+    KWin::EffectWindow *bestOther = nullptr;
+    qreal bestBottom = -1e9;
+    qreal bestOtherBottom = -1e9;
+
+    for (KWin::EffectWindow *cand : KWin::effects->stackingOrder()) {
+        if (!cand->windowClass().contains(QStringLiteral("goldengateshell"), Qt::CaseInsensitive)) {
+            continue;
+        }
+        const QRectF g = cand->frameGeometry();
+        // Abaikan topbar/notch: keduanya di tepi atas.
+        if (g.top() < screenRect.center().y()) {
+            continue;
+        }
+        const bool sameScreen = s
+            ? (KWin::effects->screenAt(g.center().toPoint()) == s)
+            : true;
+        // Pilih yang paling bawah menempel.
+        if (sameScreen) {
+            if (g.bottom() > bestBottom) {
+                bestBottom = g.bottom();
+                best = cand;
+            }
+        } else if (g.bottom() > bestOtherBottom) {
+            bestOtherBottom = g.bottom();
+            bestOther = cand;
+        }
+    }
+    return best ? best : bestOther;
+}
+
+static QRectF ggsDockTargetRect(KWin::EffectWindow *w)
+{
+    const QString dir = QStandardPaths::writableLocation(QStandardPaths::GenericCacheLocation)
+        + QStringLiteral("/goldengateshell");
+
+    KWin::EffectWindow *dock = ggsDockWindow(w);
+
+    // 1) ikon yang barusan diklik di dock (paling akurat)
+    QFile f1(dir + QStringLiteral("/minimize_target.json"));
+    if (f1.open(QIODevice::ReadOnly)) {
+        const QJsonObject o = QJsonDocument::fromJson(f1.readAll()).object();
+        const qint64 ts = static_cast<qint64>(o.value(QStringLiteral("ts")).toDouble());
+        if (!o.isEmpty() && QDateTime::currentMSecsSinceEpoch() - ts <= 2500) {
+            const QRectF r(o.value(QStringLiteral("rx")).toDouble(),
+                           o.value(QStringLiteral("ry")).toDouble(),
+                           o.value(QStringLiteral("rw")).toDouble(),
+                           o.value(QStringLiteral("rh")).toDouble());
+            const QRectF valid = ggsPlausibleRect(r, dock);
+            if (!valid.isNull()) {
+                return valid;
+            }
+        }
+    }
+
+    // 2) peta semua ikon (untuk minimize via tombol jendela / shortcut keyboard)
+    if (w) {
+        QFile f2(dir + QStringLiteral("/dock_rects.json"));
+        if (f2.open(QIODevice::ReadOnly)) {
+            const QJsonObject map = QJsonDocument::fromJson(f2.readAll()).object();
+            const QString cls = ggsNorm(w->windowClass());
+            const QString cap = ggsNorm(w->caption());
+            for (auto it = map.begin(); it != map.end(); ++it) {
+                const QString key = it.key();
+                if (key.isEmpty()) {
+                    continue;
+                }
+                const bool hit = (!cls.isEmpty() && (cls.contains(key) || key.contains(cls)))
+                    || (key.size() >= 5 && cap.contains(key));
+                if (!hit) {
+                    continue;
+                }
+                const QJsonObject r = it.value().toObject();
+                const QRectF valid = ggsPlausibleRect(
+                    QRectF(r.value(QStringLiteral("x")).toDouble(),
+                           r.value(QStringLiteral("y")).toDouble(),
+                           r.value(QStringLiteral("w")).toDouble(),
+                           r.value(QStringLiteral("h")).toDouble()),
+                    dock);
+                if (!valid.isNull()) {
+                    return valid;
+                }
+            }
+        }
+    }
+
+    return QRectF();
+}
